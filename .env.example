# Neon → Dashboard → Connect. Copier ce fichier en .env et remplir.
# Connexion "Pooled" (hôte avec -pooler) : utilisée par l'application
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/apex_ledger?sslmode=require"
# Connexion directe (sans -pooler) : utilisée par prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/apex_ledger?sslmode=require"

PORT=3001
# Front React (5173) et dashboard admin Angular (4300)
WEB_ORIGIN="http://localhost:5173,http://localhost:4300"
